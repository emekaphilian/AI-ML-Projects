# Minimal example for AI Product Engine
# Copy this file to .env and fill in your actual API keys

# CORE - Required
ENV=development
LLM_PROVIDER=openai
MODEL_NAME=gpt-4.1-mini
TEMPERATURE=0.7
MAX_TOKENS=300
OPENAI_API_KEY=sk-your-openai-key

# EMAIL - Recommended for notifications
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=your-sendgrid-api-key
FROM_EMAIL=noreply@yourdomain.com

# OPTIONAL - Analytics
GOOGLE_ANALYTICS_ID=G-XXXX

# FEATURE FLAGS (enable/disable features)
ENABLE_LOCALIZATION=true
ENABLE_RECOMMENDATION=false
ENABLE_ORIGINALITY_CHECK=false
ENABLE_ADV_MARKETING=false
ENABLE_PAYMENT_AUTOMATION=false

# ------------------------
# Optional / Integration Keys (uncomment to enable)
# ------------------------
# Social Media
# FACEBOOK_ACCESS_TOKEN=your-facebook-access-token
# INSTAGRAM_ACCESS_TOKEN=your-instagram-access-token
# TIKTOK_ACCESS_TOKEN=your-tiktok-access-token
# WHATSAPP_API_KEY=your-whatsapp-api-key

# Payment
# STRIPE_API_KEY=sk_test_your-stripe-key
# PAYPAL_CLIENT_ID=your-paypal-client-id
# PAYPAL_SECRET=your-paypal-secret

# Publishing
# GUMROAD_ACCESS_TOKEN=your-gumroad-access-token
# SELAR_API_KEY=your-selar-api-key

# Analytics & Tracking
# GOOGLE_ANALYTICS_API_KEY=your-google-analytics-key
# FACEBOOK_PIXEL_ID=your-facebook-pixel-id

# Database
DATABASE_URL=sqlite:///app/core/memory/app.db
REDIS_URL=redis://localhost:6379/0

# Server
API_PORT=8000
API_HOST=0.0.0.0
DEBUG=true

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
